{
  "version": 2,
  "builds": [
    {
      "src": "Backend/api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "Fronted/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "Backend/api/index.js" },
    { "src": "/assets/(.*)", "dest": "Fronted/dist/assets/$1" },
    { "src": "/favicon.svg", "dest": "Fronted/dist/favicon.svg" },
    { "src": "/icons.svg", "dest": "Fronted/dist/icons.svg" },
    { "src": "/(.*)", "dest": "Fronted/dist/index.html" }
  ]
}
